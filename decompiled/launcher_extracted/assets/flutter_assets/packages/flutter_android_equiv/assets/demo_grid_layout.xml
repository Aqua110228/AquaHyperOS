<?xml version="1.0" encoding="utf-8"?>
<!-- 
  GridLayout XML Example
  
  This file demonstrates all GridLayout features:
  - columnCount and rowCount attributes
  - orientation attribute (horizontal/vertical)
  - alignmentMode attribute (alignBounds/alignMargins)
  - useDefaultMargins attribute
  - columnOrderPreserved and rowOrderPreserved attributes
  - Child layout parameters (row, column, rowSpan, columnSpan)
  - Child gravity values
  - Child margins
-->
<GridLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="4"
    android:orientation="horizontal"
    android:alignmentMode="alignBounds"
    android:useDefaultMargins="false"
    android:columnOrderPreserved="true"
    android:rowOrderPreserved="true"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Header spanning all columns -->
    <TextView
        android:text="GridLayout Header"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnSpan="3"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        android:textSize="20dp"
        android:padding="16dp"
        android:background="#2196F3" />

    <!-- First row of items -->
    <TextView
        android:text="Item 1"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#4CAF50" />

    <TextView
        android:text="Item 2"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_gravity="center"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#4CAF50" />

    <TextView
        android:text="Item 3"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#4CAF50" />

    <!-- Second row with spanning item -->
    <TextView
        android:text="Wide Item"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_columnSpan="2"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#FF9800" />

    <TextView
        android:text="Tall Item"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_rowSpan="2"
        android:layout_gravity="fill_vertical"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#9C27B0" />

    <!-- Third row items -->
    <TextView
        android:text="Item 6"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_gravity="start"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#00BCD4" />

    <TextView
        android:text="Item 7"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_gravity="end"
        android:layout_margin="4dp"
        android:textSize="16dp"
        android:padding="12dp"
        android:background="#00BCD4" />

</GridLayout>
