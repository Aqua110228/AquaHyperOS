uniform float2  uGeoPxPos;
uniform float3  uGeoPxSize;
uniform float uAlpha;
uniform float uShapeEdgePx;
uniform float uShapeEdgePow;

// ==== 玻璃材质参数 - 像素坐标 ====
// uniform float2  uRefractEdgeScale;

// ==== 最终颜色参数 ====
uniform float uColorPow;
uniform float uColorAdd;

uniform float uDarker;
// ==== 平行光参数 ====
uniform float3  uDirectionalLightDirection;
uniform float uDirectionalLightIntensity;
uniform float uDirectionalLightOppositeIntensity;
uniform float uDirectionalLightAngleRange;
uniform float uDirectionalLightMinLight;
uniform float uDirectionalLightLightWidth;
uniform float2  uDarkerRange;

uniform float2 uScale;

// Rotation parameters for anti-rotation
uniform float2 uRotationTrig;

uniform shader uBgColorTex;

float smooth5Map(float t)
{
    t = mix(0.5, 1.0, t);
    t = clamp(t, 0.0, 1.0);
    t = t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    t = (t - 0.5) * 2.0;
    return t;
}

float smooth5_vertical(float x, float k)
{
    float t = pow(clamp(x, 0.0, 1.0), k);
    return smooth5Map(t);
}

float _clamp(float a)
{
    return clamp(a, 0.0, 1.0);
}

float curve(float x, float powRatio)
{
    if(x >= 0.85)
        return 1.0;
    x = _clamp(x);
    float circle = smooth5_vertical(x, 0.5);
    float inputVal  = circle;
    float circlePow = 1.0 - pow(1.0 - inputVal, powRatio);
    return circlePow;
}

float box(float2 p, float2 b, float r)
{
    float2 d = abs(p) - b + r;
    return min(max(d.x, d.y), 0.0) + length(max(d, 0.0)) - r;
}

// ====================== Supercircle SDF ======================
vec3 supercircle_sdf(vec2 point, vec2 center, float radius, vec2 axisMix)
{
    // 半径处理
    float absRadius = abs(radius);
    float scaledRadius = 1.5286649465560913 * absRadius;
    float blendedRadius = mix(scaledRadius, radius, max(axisMix.x, axisMix.y));
    // 坐标归一化
    vec2 offset = point - center;
    vec2 shiftedPos = vec2(scaledRadius) + offset;
    vec2 normalizedPos = max(vec2(0.0), shiftedPos / scaledRadius);
    vec2 absNormPos = abs(normalizedPos);
    // 长宽比 [0,1] （越接近1越像正方形）
    float axisRatio = max(absNormPos.x, absNormPos.y) == 0.0 ? 0.0 : clamp(min(absNormPos.x, absNormPos.y) / max(absNormPos.x, absNormPos.y), 0.0, 1.0);
    float polyFit = (((( -0.7391197269 * axisRatio + 2.4034927648 ) * axisRatio - 2.4907319173 ) * axisRatio + 0.4768708960 ) * axisRatio + 0.4747847594);
    float distBase = (length(absNormPos) + 1.0) - 1.0 / (1.0 - axisRatio * axisRatio * clamp(length(absNormPos), 0.0, 1.0) * polyFit);
    // 备用距离，用于边角平滑
    float distAlt = 0.6541655659675598 * length(max(vec2(0.0), 1.5286649465560913 * absNormPos - vec2(0.5286650061607361))) + 0.3458344340324402;
    float distMixX = mix(distBase, distAlt, axisMix.x);
    float distMixY = mix(distBase, distAlt, axisMix.y);
    float axisSign = absNormPos.y > absNormPos.x ? 1.0 : -1.0;
    float finalMix = mix(distMixX, distMixY, clamp(0.5 - axisSign + axisSign * axisRatio, 0.0, 1.0));
    vec2 radialPos = vec2(blendedRadius) + offset;
    vec2 dirNorm = normalize(max(vec2(0.0), radialPos));
    vec2 fallbackDir = dirNorm.x + dirNorm.y > 0.0 ? dirNorm : radialPos.x > radialPos.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    float finalHeight = min(max(radialPos.x, radialPos.y), 0.0) + scaledRadius * (finalMix - 1.0);
    return vec3(finalHeight, fallbackDir);
}

half sdfRect(float2 p, float2 b, float r, float edge, bool useSmoothstep, float edgePow)
{
    float minR = min(b.x, b.y);
    bool isCircle = (minR - r) <= 1.0;
    vec3 sdfResult = isCircle ? vec3(box(abs(p), b, r)) : supercircle_sdf(abs(p), b, r, vec2(0.0, 0.0));
    float d = sdfResult.x;

    if(d < -edge)
        d = -edge;
    else if(d < 0.0)
    {
        float per = -d / edge;
        per = useSmoothstep ? curve(per, 1.0) : curve(per, edgePow);
        d = -per * edge;
    }
    return half(d);
}

half shape(float2 pos, float2 halfSize, float radius, float edge, bool useSmoothstep, float edgePow)
{
    return sdfRect(pos, halfSize, radius, edge, useSmoothstep, edgePow);
}

// 计算法向量
half3 calculateNormal(float2 uvPx, float2 centerPx, float2 sizePx, float radiusPx, float edge, float edgePow, half noiseStrength)
{
    float2  halfSizePx = sizePx * 0.5;
    float2  pos = uvPx - centerPx;
    half eps = 1.0;
    half rightSdf = shape(pos + float2(eps, 0.0), halfSizePx, radiusPx, edge, false, edgePow);
    half leftSdf  = shape(pos - float2(eps, 0.0), halfSizePx, radiusPx, edge, false, edgePow);
    half topSdf   = shape(pos + float2(0.0, eps), halfSizePx, radiusPx, edge, false, edgePow);
    half bottomSdf= shape(pos - float2(0.0, eps), halfSizePx, radiusPx, edge, false, edgePow);
    half2 xyGradient = half2((rightSdf - leftSdf) * 0.5, (topSdf - bottomSdf) * 0.5);
// MIUI MOD: SF_AllInOneGlass
    // return (half3(xyGradient, 1.0));
    return normalize(half3(xyGradient, 1.0));
// END SF_AllInOneGlass
}

half luma(half3 color)
{
    return dot(color, half3(0.2126, 0.7152, 0.0722));
}

half4 hsvv(half4 col, half lighten) {
    half v   = luma(col.rgb);

    // 1. 背景亮度
    half w   = smoothstep(0.0, 0.5, v);
    // 2. 高亮区间中点
    half k   = mix(1.0-v, v, w);
    // 3. 高亮区间长度
    half g   = 1.0 + smoothstep(0.0, 1.0, lighten) * mix(0.75, 0.4, w);// + lighten * 2.0 * w;

    half4  out_rgb = half4((col.rgb + k) * g - k, col.a);
    return out_rgb;
}

half dynamicAdd(half3 color)
{
	half whiteDis = distance(half3(1.), color);
	whiteDis       = smoothstep(0.2, 1., whiteDis);
	whiteDis       = mix(0.2, 1., whiteDis);
	half lumin = luma(color);
	return mix(0.8, whiteDis, lumin);
}

half getLighten(vec2 uv)
{
    return 0.0;
}

half4 textureBlur(vec2 uv, bool isBg)
{
    half lighten = getLighten(uv * uGeoPxSize.xy);
    uv *= (uGeoPxSize.xy * uScale);
    uv -= vec2(uGeoPxPos.x * uScale.x, uGeoPxPos.y * uScale.y);
    half4 col = uBgColorTex.eval(uv);

    {
        half luma = luma(col.rgb);
        col.rgb = mix(col.rgb, half3(0.07874, 0.02848, 0.09278), mix(0., half(uDarker), smoothstep(half(uDarkerRange.x), half(uDarkerRange.y), luma)));
    }
    col = lighten > 0. ? hsvv(col, lighten) : col;
    return col;
}

half calculateLighting(vec2 uvPx, half3 normal, half3 lightDirection, half intensity)
{
	half3  normalizedLightDir = normalize(lightDirection);
	half dotProduct         = dot(normal, normalizedLightDir);
	half reflectionAngle = acos(clamp(dotProduct, -1.0, 1.0));
	half angleFactor     = 1.0 - (reflectionAngle / (3.14159 * half(uDirectionalLightAngleRange)));
	half adjustedIntensity = intensity * angleFactor;
	adjustedIntensity       = max(adjustedIntensity, 0.0);
	half lighting = max(dotProduct, 0.0) * adjustedIntensity;
	return lighting;
}

half4 processLighting(half4 color, vec2 uvDisplayPx, half3 normal, half sdf){
	half lightingStrength         = half(uDirectionalLightIntensity);
	half lightingOppositeStrength = half(uDirectionalLightOppositeIntensity);
	half3 lightNormal = normal;
    lightNormal.y = -lightNormal.y;
	half lighting1 = calculateLighting(uvDisplayPx, lightNormal, half3(uDirectionalLightDirection), lightingStrength);
	half lighting2 = calculateLighting(uvDisplayPx, lightNormal, half3(uDirectionalLightDirection) * half3(-1., -1., 1.), lightingOppositeStrength);

    half hsvLight = 1.0;
	half lightRatio = dynamicAdd(color.rgb);
  half rawLight = (lighting1 + lighting2) * hsvLight * lightRatio;
  rawLight = pow(clamp(rawLight, half(0.0), half(1.0)), half(0.85));

  half lumin = luma(color.rgb);
  half knee = mix(half(1.0), half(0.7), smoothstep(half(0.0), half(0.5), lumin));
  half lightenParam = rawLight / (rawLight + knee);

    color = hsvv(color, lightenParam);

	return color;
}

half4 renderGlassShape(half2 n2, half boxSdf, vec2 uvPx, vec2 centerPx, vec2 sizePx, float radiusPx, vec2 vUv) {
    half edge    = half(uShapeEdgePx);
	half finalAlpha = smoothstep(-0., -min(edge, 25.), -boxSdf * edge);

	half normalizedSdf = boxSdf;
	bool isInnerBox = (1. - normalizedSdf) <= 0.000001;
	half2 nlmXY = n2;
	half3 lightNormal = isInnerBox ? half3(0, 0, 1) :  half3(nlmXY.rg, max(0.0, sqrt(1.0- nlmXY.r * nlmXY.r - nlmXY.g * nlmXY.g)));

    // 准备显示坐标
    vec2 uvDisplayPx = uvPx;
    // Rotate around the control center to counteract canvas rotation
    vec2 offset = uvDisplayPx - centerPx;
    float cosAngle = uRotationTrig.x;
    float sinAngle = uRotationTrig.y;
    uvDisplayPx = centerPx + vec2(
        offset.x * cosAngle - offset.y * sinAngle,
        offset.x * sinAngle + offset.y * cosAngle
    );

    half4 glassMaterial = textureBlur(vUv, true);
   	glassMaterial = isInnerBox ? glassMaterial : processLighting(glassMaterial, uvDisplayPx, lightNormal, normalizedSdf);

   	glassMaterial = pow(glassMaterial, vec4(uColorPow));
   	glassMaterial.rgb = clamp(glassMaterial.rgb, 0.0, 1.0);

   	// 透明度调整
   	glassMaterial.a *= finalAlpha * half(uAlpha);
    return glassMaterial;
}

half4 main(vec2 xy) {
    half4 color = half4(0.0);
    vec2 screenUV = xy / uGeoPxSize.xy;

    half2 uvPx = half2(xy);
    half rectWidth = half(uGeoPxSize.x);
    half rectHeight = half(uGeoPxSize.y);
    half rectRadius = half(uGeoPxSize.z);
    half rectEdge = half(uShapeEdgePx);
    half uShapeEdgePowH = half(uShapeEdgePow);
    half2 size = half2(rectWidth, rectHeight);
    half2 centerPx = size * 0.5;
    half2 halfSizePx    =  centerPx;
    centerPx.y = rectHeight - centerPx.y;
    half2 posFromCenter = uvPx - centerPx;
    half d = sdfRect(posFromCenter, halfSizePx, rectRadius, rectEdge, false, uShapeEdgePowH);
    half3 normal =  (d <= -rectEdge) ? half3(0, 0, 1) : calculateNormal(uvPx, centerPx, size, rectRadius, rectEdge, uShapeEdgePowH, half(1.0));

    half sdf = -d / rectEdge;

    color = (sdf <= 0.) ? half4(0.0) : renderGlassShape(normal.xy, sdf, xy, centerPx, uGeoPxSize.xy, uGeoPxSize.z, screenUV);

    return half4(color.rgb * color.a, color.a);
}
