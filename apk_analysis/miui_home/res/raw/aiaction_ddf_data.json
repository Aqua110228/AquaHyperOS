{
  "type": "urn:aiot-spec-v3:com.mi.phones:device:phones:0:1.0",
  "description": "MiuiHome launcher ddf",
  "protocol-version": "3.0",
  "class": "MiPhone",
  "dynamic": 0,
  "ddfid": 10551298,

  "modules": [
    {
      "iid": 1,
      "type": "urn:aiot-spec-v3:com.mi.phones:module:[com.miui.home]:0:1.0",
      "description": "MIUI Home launcher module",
      "name": "com.miui.home",
      "services": [
        {
          "iid": 1,
          "type": "urn:aiot-spec-v3:com.mi.phones:service:[com.miui.home/miuihome]:0:1.0",
          "description": "MIUI Home service",
          "name": "miuihome",
          "actions": [
            {
              "iid": 1,
              "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.miui.home/miuihome/settings-open]:0:1.0",
              "description": "打开桌面设置页",
              "in": [],
              "out": [
                {
                  "name": "status",
                  "description": "执行状态",
                  "format": "int32",
                  "value-list": [
                    { "value": 0, "description": "执行成功" },
                    { "value": -1, "description": "执行失败" },
                    { "value": -10, "description": "已在桌面设置页" }
                  ]
                }
              ]
            },
            {
              "iid": 2,
              "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.miui.home/miuihome/PA-settings-open]:0:1.0",
              "description": "打开负一屏设置页",
              "in": [],
              "out": [
                {
                  "name": "status",
                  "description": "执行状态",
                  "format": "int32",
                  "value-list": [
                    { "value": 0, "description": "执行成功" },
                    { "value": -1, "description": "执行失败" },
                    { "value": -10, "description": "已在负一屏设置页" }
                  ]
                }
              ]
            },
            {
              "iid": 3,
              "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.miui.home/miuihome/PA-toggle]:0:1.0",
              "description": "打开/关闭负一屏",
              "in": [
                {
                  "name": "enable",
                  "description": "开启或关闭负一屏",
                  "format": "boolean"
                }
              ],
              "out": [
                {
                  "name": "status",
                  "description": "执行状态",
                  "format": "int32",
                  "value-list": [
                    { "value": 0, "description": "执行成功" },
                    { "value": -1, "description": "执行失败" },
                    { "value": -11, "description": "负一屏已打开" },
                    { "value": -12, "description": "负一屏已关闭" }
                  ]
                },
                {
                  "format": "boolean",
                  "name": "result",
                  "description": "负一屏当前开启状态",
                  "value-list": [
                    { "value": true, "description": "负一屏已开启" },
                    { "value": false, "description": "负一屏已关闭" }
                  ]
                }
              ]
            },
            {
              "iid": 4,
              "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.miui.home/miuihome/PA-query]:0:1.0",
              "description": "查询负一屏开关状态",
              "in": [],
              "out": [
                {
                  "name": "status",
                  "description": "执行状态",
                  "format": "int32",
                  "value-list": [
                    { "value": 0, "description": "执行成功" },
                    { "value": -1, "description": "执行失败" }
                  ]
                },
                {
                  "format": "boolean",
                  "name": "result",
                  "description": "负一屏当前开启状态",
                  "value-list": [
                    { "value": true, "description": "负一屏已开启" },
                    { "value": false, "description": "负一屏已关闭" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
