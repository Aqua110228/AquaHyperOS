              "x": "var $bm_rt;\nvar duration = 0.6;\nvar bounce = 0;\nvar initialVelocity = 0;\nvar fromKey = 1;\nfunction springTimingFunction(to, from, t) {\n    var z = $bm_sub(1, bounce);\n    var w = $bm_div($bm_mul(2, Math.PI), duration);\n    var v = initialVelocity;\n    var s = $bm_sub(from, to);\n    var c = $bm_mul(w, z);\n    var a = $bm_mul(w, Math.sqrt(Math.abs($bm_sub(1, $bm_mul(z, z)))));\n    if (z > 1) {\n        const A = $bm_mul(a, s);\n        const B = $bm_sum(v, $bm_mul(c, s));\n        return $bm_sum(to, $bm_div($bm_mul(Math.exp($bm_mul($bm_neg(c), t)), $bm_sum($bm_mul(A, Math.cosh($bm_mul(a, t))), $bm_mul(B, Math.sinh($bm_mul(a, t))))), a));\n    } else if (z === 1) {\n        const A = s;\n        const B = $bm_sum(v, $bm_mul(c, s));\n        return $bm_sum(to, $bm_mul(Math.exp($bm_mul($bm_neg(c), t)), $bm_sum(A, $bm_mul(B, t))));\n    } else {\n        const A = s;\n        const B = $bm_div($bm_sum(v, $bm_mul(c, s)), a);\n        return $bm_sum(to, $bm_mul(Math.exp($bm_mul($bm_neg(c), t)), $bm_sum($bm_mul(A, Math.cos($bm_mul(a, t))), $bm_mul(B, Math.sin($bm_mul(a, t))))));\n    }\n}\nfunction timing() {\n    try {\n        var from = key(fromKey);\n        var to = key($bm_sum(fromKey, 1));\n    } catch (e) {\n        return null;\n    }\n    var dim = 1;\n    try {\n        from[1];\n        dim = 2;\n        from[2];\n        dim = 3;\n    } catch (e) {\n    }\n    var t = $bm_sub(time, from.time);\n    if (time < from.time || time > to.time) {\n        return value;\n    }\n    var result = [];\n    for (var i = 0; i < dim; i++) {\n        result.push(springTimingFunction(to[i], from[i], t));\n    }\n    return dim === 1 ? result[0] : result;\n}\n$bm_rt = timing() || value;"
