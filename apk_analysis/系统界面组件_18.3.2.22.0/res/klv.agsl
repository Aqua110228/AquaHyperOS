uniform half2 uResolution;
uniform half2 uInputResolution;
uniform half uTime;// nouse
uniform shader uTex;// nouse
uniform shader uTex1;// nouse
uniform half2 uSize;


uniform half uEdgeHighlightProgress;
uniform half uEdgeHighlightDim;
uniform half uSdfRadius;
uniform half uAlpha;

half4 blendAlpha(half4 src, half4 dst) {
    half3 color = src.rgb + (1.0 - src.a) * dst.rgb;
    half alpha = src.a + dst.a * (1.0 - src.a);
    return half4(color, alpha);
}

half sdRoundedBox(in half2 p, in half2 b, in half4 r) {
    r.xy = (p.x > 0.0) ? r.xy : r.zw;
    r.x = (p.y > 0.0) ? r.x : r.y;
    half2 q = abs(p) - b + r.x;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r.x;
}


half drawInnerGlow(half d, half strength) {
    return clamp(exp(d * strength) * smoothstep(2.0 * 1e-3, 0.0, d), 0.0, 1.0);
}

half drawInnerGlowRoundedRect(half2 uv, half rectGlow, half rectGlowPower) {
    half2 rectSize = half2(uSize.x / uResolution.y, uSize.y / uResolution.y);
    half rectRadius = uSdfRadius / uResolution.y;
    half d = sdRoundedBox(uv, rectSize / 2., half4(rectRadius));
    half k = uResolution.y / (3.11 * 223.0);
    half glow = drawInnerGlow(d * k, rectGlow) * rectGlowPower;
    return glow;
}

// 0 pe    pf pr
//    ______          vp
//   /      \
//  /        \______  vr
// /                  vi

half pulse(half x, half pe, half pf, half pr, half vi, half vr, half vp) {
    half v = min(vp, mix(vi, vp, smoothstep(0.0, pe, x)));
    v = min(v, mix(vp, vr, smoothstep(pf, pr, x)));
    v += vi;
    return v;
}

half4 main(vec2 fragCoord){
//    return half4(1.0,1.0,0.0,1.0);
    half2 vUv = fragCoord / uResolution;

    half2 vUv_rvs = half2(vUv.x, 1.0 - vUv.y);
    half2 uv = vUv_rvs - 0.5;
//    if (0.495 - abs(uv.x) < 1.0 / uResolution.x || 0.495 - abs(uv.y) < 1.0 / uResolution.y) {
//        return half4(0.0, 1.0, 0.0, 1.0);
//    }
    uv.x *= uResolution.x / uResolution.y;
    half edgeGlow = 0.0;

    //提前计算无效区域
    half2 st = vUv - 0.5;
    st /= half2(0.45, 1.0);
    st *= 0.3863207547;
    st += 0.5;
    half4 color = uTex1.eval(st * uInputResolution);
    half luminance = dot(color.rgb, half3(0.299, 0.587, 0.114));
    half staticPower = mix(1.0, 1.0, uEdgeHighlightProgress);
    half flickerPower = staticPower * smoothstep(0.5, 0.7, luminance);
    half power = mix(staticPower, flickerPower, uEdgeHighlightProgress);
    half radius = mix(20.0, 40.0, uEdgeHighlightProgress);
    half edge = drawInnerGlowRoundedRect(uv, radius, power);
    if(edge <= 0.00001) {
        return half4(0.,0.,0.,0.);
    }

    half2 st3 = vUv - 0.5;
    st3.y = -st3.y;
    half theta = atan(st3.y / abs(st3.x)) / 3.14 + 0.5;
    half t = theta + uEdgeHighlightProgress;
    t = mix(t - 1.0, 1.0, uEdgeHighlightProgress);
    half factor = pulse(t, 0.4, 0.4, 0.8, 0.2, 0.8, 1.3);
    color *= edge * factor;
    color *= mix(1.0, 0.0, uEdgeHighlightDim);
    half4 fragColor = color;
    fragColor *= uAlpha;
    return fragColor;
}
